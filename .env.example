# NeatSpace-Core environment contract (WP1).
# Copy to .env for local runs. In CI/production these come from GitHub Actions Secrets.

# --- Database (required) ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DB=affiliate-pinner

# --- Encryption master key for Pinterest OAuth tokens (required, 32-byte hex) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_MASTER_KEY=

# --- Gemini (required from Phase 2) ---
GEMINI_API_KEY=

# --- AliExpress Portals affiliate (validated in Phase 0) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- GitHub bridge repos (fine-grained PAT, contents:write, scoped to bridge repos) ---
BRIDGE_PAT=

# --- Pinterest app (for OAuth token refresh; tokens themselves live encrypted in Mongo) ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Telegram alerts (Phase 3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tests only: Mongo instance used by the test suite. ---
# Default: mongodb://localhost:27017 (CI uses a mongo:7 service container).
# If you point this at Atlas, tests will ONLY touch MONGO_TEST_DB and DROP it on each run.
# MONGO_TEST_URI=
# MONGO_TEST_DB=affiliate-pinner-test
# Set to 1 to make "Mongo unreachable" a hard failure instead of a skip (CI does this).
# MONGO_TEST_REQUIRE=1
